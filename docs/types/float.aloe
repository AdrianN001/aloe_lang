##
# datatype: float
# 64-bit floating point number.
# storage: stack
# example:
#
# ---float-literal.aloe---
# let pi = 3.14;
# let negative = -0.5;
#
##
struct float{

    ##
    # float.is_negative -> bool
    # returns true if the sign of the value is negative.
    # panics: []
    # errors: []
    # example:
    #
    # ---is_negative.aloe---
    # let n = -5.0;
    # n.is_negative; # true
    #
    ##
    fun is_negative(){}

    ##
    # float.is_positive -> bool
    # returns true if the sign of the value is positive.
    # panics: []
    # errors: []
    # example:
    #
    # ---is_positive.aloe---
    # let n = 5.0;
    # n.is_positive; # true
    #
    ##
    fun is_positive(){}

    ##
    # float.as_str() -> str
    # converts the float into a string.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_str.aloe---
    # 3.14.as_str(); # "3.14"
    #
    ##
    fun as_str(this){}

    ##
    # float.as_int() -> int
    # converts the float into an integer, truncating the decimal part.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_int.aloe---
    # 3.99.as_int(); # 3
    #
    ##
    fun as_int(this){}

    ##
    # float.as_float() -> float
    # returns a copy of the float.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_float.aloe---
    # 3.14.as_float(); # 3.14
    #
    ##
    fun as_float(this){}

    ##
    # float.clone() -> float
    # returns a copy of the float.
    # panics: [WrongArgumentCount]
    # errors: []
    #
    ##
    fun clone(this){}
}
