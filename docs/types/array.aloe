##
# datatype: array
# ordered, growable collection of values.
# storage: heap
# example:
#
# ---array-literal.aloe---
# let items = [1, 2, 3];
# let empty = [];
#
##
struct array{

    ##
    # array.length -> int
    # returns the number of elements in the array.
    # panics: []
    # errors: []
    # example:
    #
    # ---length.aloe---
    # let items = [1, 2, 3];
    # items.length; # 3
    #
    ##
    fun length(){}

    ##
    # array.reversed() -> array
    # returns a reversed copy of the array.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---reversed.aloe---
    # [1, 2, 3].reversed(); # [3, 2, 1]
    #
    ##
    fun reversed(this){}

    ##
    # array.push(...values: any) -> null
    # appends one or more values to the end of the array.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---push.aloe---
    # let items = [1, 2];
    # items.push(3); # [1, 2, 3]
    #
    ##
    fun push(this, values){}

    ##
    # array.extend(other: array) -> null
    # appends all elements of another array to the end of this array.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---extend.aloe---
    # let items = [1, 2];
    # items.extend([3, 4]); # [1, 2, 3, 4]
    #
    ##
    fun extend(this, other){}

    ##
    # array.clear() -> null
    # removes all elements from the array.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---clear.aloe---
    # let items = [1, 2, 3];
    # items.clear(); # []
    #
    ##
    fun clear(this){}

    ##
    # array.remove(index: int)? -> any
    # removes and returns the element at the given index.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: [IndexOutOfBound]
    # example:
    #
    # ---remove.aloe---
    # let items = [1, 2, 3];
    # items.remove(0)!; # 1
    #
    ##
    fun remove(this, index){}

    ##
    # array.slice(start: int, end: int) -> array
    # returns a subarray between two indices.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---slice.aloe---
    # [1, 2, 3, 4].slice(1, 3); # [2, 3]
    #
    ##
    fun slice(this, start, end){}

    ##
    # array.insert(index: int, value: any)? -> null
    # inserts a value at the given index.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: [IndexOutOfBound]
    # example:
    #
    # ---insert.aloe---
    # let items = [1, 2, 3];
    # items.insert(1, 99)!; # [1, 99, 2, 3]
    #
    ##
    fun insert(this, index, value){}

    ##
    # array.clone() -> array
    # returns a deep copy of the array.
    # panics: [WrongArgumentCount]
    # errors: []
    #
    ##
    fun clone(this){}

    ##
    # array.contains(value: any) -> bool
    # checks whether the array contains a value.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---contains.aloe---
    # [1, 2, 3].contains(2); # true
    #
    ##
    fun contains(this, value){}

    ##
    # array.map(mapper: fun) -> array
    # returns a new array with the mapper function applied to each element.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---map.aloe---
    # [1, 2, 3].map(fn(x){ x * 2; });
    # # [2, 4, 6]
    #
    ##
    fun map(this, mapper){}

    ##
    # array.filter(predicate: fun) -> array
    # returns a new array containing only the elements for which the predicate returns true.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---filter.aloe---
    # [1, 2, 3, 4].filter(fn(x){ x > 2; });
    # # [3, 4]
    #
    ##
    fun filter(this, predicate){}

    ##
    # array.as_iter() -> iterator
    # returns an iterator over the array's elements.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_iter.aloe---
    # for item <- [1, 2, 3].as_iter(){
    #     println(item);
    # }
    #
    ##
    fun as_iter(this){}

    ##
    # array.as_buffer() -> buffer
    # converts an array of integers (0-255) into a buffer.
    # panics: [WrongArgumentCount, WrongType, IllegalTypeCasting]
    # errors: []
    # example:
    #
    # ---as_buffer.aloe---
    # let data = [104, 105].as_buffer();
    #
    ##
    fun as_buffer(this){}

    ##
    # array.enumerate() -> iterator
    # returns an iterator yielding [index, value] pairs.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---enumerate.aloe---
    # for pair <- ["a", "b"].enumerate(){
    #     println(pair);
    # }
    #
    ##
    fun enumerate(this){}

    ##
    # array.zip(...others: array) -> iterator
    # returns an iterator combining this array with one or more other arrays, stopping at the shortest.
    # panics: [WrongArgumentType]
    # errors: []
    # example:
    #
    # ---zip.aloe---
    # for pair <- [1, 2].zip(["a", "b"]){
    #     println(pair);
    # }
    #
    ##
    fun zip(this, others){}

    ##
    # array.join(separator?: str) -> str
    # joins the elements of the array into a string, separated by the given separator.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---join.aloe---
    # [1, 2, 3].join(", "); # "1, 2, 3"
    #
    ##
    fun join(this, separator){}
}
