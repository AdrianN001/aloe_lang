##
# datatype: int
# 64-bit signed integer.
# storage: stack
# example:
#
# ---int-literal.aloe---
# let count = 42;
# let negative = -7;
#
##
struct int{

    ##
    # int.is_negative -> bool
    # returns true if the value is negative.
    # panics: []
    # errors: []
    # example:
    #
    # ---is_negative.aloe---
    # let n = -5;
    # n.is_negative; # true
    #
    ##
    fun is_negative(){}

    ##
    # int.is_positive -> bool
    # returns true if the value is positive.
    # panics: []
    # errors: []
    # example:
    #
    # ---is_positive.aloe---
    # let n = 5;
    # n.is_positive; # true
    #
    ##
    fun is_positive(){}

    ##
    # int.as_str(radix?: int) -> str
    # converts the integer into a string, optionally using a radix (2, 8 or 16).
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: [WrongRadix]
    # example:
    #
    # ---as_str.aloe---
    # 42.as_str(); # "42"
    # 255.as_str(16); # "ff"
    #
    ##
    fun as_str(this, radix){}

    ##
    # int.as_float() -> float
    # converts the integer into a float.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_float.aloe---
    # 42.as_float(); # 42.0
    #
    ##
    fun as_float(this){}

    ##
    # int.as_int() -> int
    # returns a copy of the integer.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_int.aloe---
    # 42.as_int(); # 42
    #
    ##
    fun as_int(this){}

    ##
    # int.as_utf_char()? -> str
    # converts the integer into a UTF-8 character.
    # panics: [WrongArgumentCount]
    # errors: [UTFValueCasting]
    # example:
    #
    # ---as_utf_char.aloe---
    # 65.as_utf_char()!; # "A"
    #
    ##
    fun as_utf_char(this){}

    ##
    # int.as_le_bytes() -> buffer
    # converts the integer into a buffer of little-endian bytes.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_le_bytes.aloe---
    # let data = 42.as_le_bytes();
    #
    ##
    fun as_le_bytes(this){}

    ##
    # int.as_be_bytes() -> buffer
    # converts the integer into a buffer of big-endian bytes.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_be_bytes.aloe---
    # let data = 42.as_be_bytes();
    #
    ##
    fun as_be_bytes(this){}

    ##
    # int.clone() -> int
    # returns a copy of the integer.
    # panics: [WrongArgumentCount]
    # errors: []
    #
    ##
    fun clone(this){}
}
