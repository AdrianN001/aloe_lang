##
# datatype: str
# UTF-8 encoded immutable string.
# storage: heap
# example:
#
# ---str-literal.aloe---
# let name = "Alice";
# let empty = "";
#
##
struct str{

    ##
    # str.length -> int
    # returns the number of bytes in the string.
    # panics: []
    # errors: []
    # example:
    #
    # ---length.aloe---
    # let text = "Hello";
    # text.length; # 5
    #
    ##
    fun length(){}

    ##
    # str.reversed() -> str
    # returns a reversed copy of the string.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---reversed.aloe---
    # let text = "Hello";
    # text.reversed(); # "olleH"
    #
    ##
    fun reversed(this){}

    ##
    # str.chars() -> iterator
    # returns an iterator over all characters.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---chars.aloe---
    # for c in "abc".chars(){
    #     println(c);
    # }
    #
    ##
    fun chars(this){}

    ##
    # str.as_float()? -> float
    # converts the string into a float.
    # panics: [WrongArgumentCount]
    # errors: [InvalidFloat]
    # example:
    #
    # ---as_float.aloe---
    # "3.14".as_float()!; # 3.14
    #
    ##
    fun as_float(this){}

    ##
    # str.as_int(radix?: int)? -> int
    # converts the string into an integer.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: [WrongRadix, InvalidInteger]
    # example:
    #
    # ---as_int.aloe---
    # "42".as_int()!; # 42
    #
    ##
    fun as_int(this, radix){}

    ##
    # str.as_str() -> str
    # returns a copy of the string.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_str.aloe---
    # let text = "hello";
    # text.as_str();
    #
    ##
    fun as_str(this){}

    ##
    # str.as_buffer() -> buffer
    # converts the string into a UTF-8 buffer.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---as_buffer.aloe---
    # let data = "hello".as_buffer();
    #
    ##
    fun as_buffer(this){}

    ##
    # str.strip(pattern?: str) -> str
    # removes leading and trailing whitespace.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---strip.aloe---
    # " hello ".strip(); # "hello"
    #
    ##
    fun strip(this, pattern){}

    ##
    # str.lstrip(pattern?: str) -> str
    # removes leading whitespace.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---lstrip.aloe---
    # " hello".lstrip(); # "hello"
    #
    ##
    fun lstrip(this, pattern){}

    ##
    # str.rstrip(pattern?: str) -> str
    # removes trailing whitespace.
    # panics: [WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---rstrip.aloe---
    # "hello ".rstrip(); # "hello"
    #
    ##
    fun rstrip(this, pattern){}

    ##
    # str.replace(old: str, new: str, count?: int) -> str
    # replaces all occurrences of a substring.
    # panics: [WrongArgumentType, WrongArgumentCount]
    # errors: []
    # example:
    #
    # ---replace.aloe---
    # "hello".replace("l", "x");
    # # "hexxo"
    #
    ##
    fun replace(this, old, new, count){}

    ##
    # str.contains(value: str) -> bool
    # checks whether a substring exists.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---contains.aloe---
    # "hello".contains("ell");
    # # true
    #
    ##
    fun contains(this, value){}

    ##
    # str.slice(start: int, end: int) -> str
    # returns a substring.
    # panics: [WrongArgumentCount, WrongArgumentType, IndexOutOfBounds]
    # errors: []
    # example:
    #
    # ---slice.aloe---
    # "hello".slice(1,4);
    # # "ell"
    #
    ##
    fun slice(this, start, end){}

    ##
    # str.split(separator?: str) -> array
    # splits the string into an array.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    # example:
    #
    # ---split.aloe---
    # "a,b,c".split(",");
    #
    ##
    fun split(this, separator){}

    ##
    # str.clone() -> str
    # returns a copy of the string.
    # panics: [WrongArgumentCount]
    # errors: []
    #
    ##
    fun clone(this){}

    ##
    # str.to_lower() -> str
    # converts all characters to lowercase.
    # panics: [WrongArgumentCount]
    # errors: []
    #
    ##
    fun to_lower(this){}

    ##
    # str.to_upper() -> str
    # converts all characters to uppercase.
    # panics: [WrongArgumentCount]
    # errors: []
    ##
    fun to_upper(this){}

    ##
    # str.is_empty() -> bool
    # returns true if the string contains no characters.
    # panics: [WrongArgumentCount]
    # errors: []
    ##
    fun is_empty(this){}

    ##
    # str.is_ascii() -> bool
    # returns true if all characters are ASCII.
    # panics: [WrongArgumentCount]
    # errors: []
    ##
    fun is_ascii(this){}

    ##
    # str.is_digit() -> bool
    # returns true if all characters are digits.
    # panics: [WrongArgumentCount]
    # errors: []
    ##
    fun is_digit(this){}

    ##
    # str.starts_with(prefix: str) -> bool
    # checks whether the string starts with a prefix.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    ##
    fun starts_with(this, prefix){}

    ##
    # str.ends_with(prefix: str) -> bool
    # checks whether the string ends with a suffix.
    # panics: [WrongArgumentCount, WrongArgumentType]
    # errors: []
    ##
    fun ends_with(this, suffix){}
}
